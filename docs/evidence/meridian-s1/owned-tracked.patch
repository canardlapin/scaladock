+        supports
+      )
+      assertEquals(scheme(scene), Option.when(supports)("LIGHT"))
+      assertEquals(DockTheme.Dark.applyWindowScheme(scene), supports)
+      assertEquals(DockTheme.Custom("unknown.css").applyWindowSchemeOrPlatform(scene), supports)
