+  private def openOverlays(): Unit =
+    val value = dock.get
+    val tab   = value.view.lookup(".dock-tab")
+    val p     = tab.localToScreen(6, 6)
+    Event.fireEvent(
+      tab,
+      new ContextMenuEvent(
